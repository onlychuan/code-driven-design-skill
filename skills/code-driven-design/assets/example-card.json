{
  "schema_version": 1,
  "title": "Field Notes / Community Insert",
  "size_mm": [90, 55],
  "bleed_mm": 3,
  "safe_mm": 4,
  "colors": {
    "paper": {"hex": "#F8F5ED", "cmyk": [0, 0, 0, 0], "note": "Unprinted warm-white stock; digital appearance is a reference."},
    "ink": {"hex": "#151C22", "cmyk": [0, 0, 0, 100]},
    "accent": {"hex": "#166B58", "cmyk": [80, 15, 60, 20], "note": "Working process recipe; confirm the chosen stock and physical proof."},
    "muted": {"hex": "#5E666B", "cmyk": [0, 0, 0, 62]},
    "rule": {"hex": "#B5B7AE", "cmyk": [0, 0, 0, 28]},
    "qr_black": {"hex": "#000000", "cmyk": [0, 0, 0, 100]},
    "qr_white": {"hex": "#FFFFFF", "cmyk": [0, 0, 0, 0]}
  },
  "fonts": {
    "body": {"family": "Arial, Helvetica, sans-serif", "weight": 400},
    "label": {"family": "Courier New, monospace", "weight": 400}
  },
  "faces": [
    {
      "id": "front",
      "name": "Front",
      "background": "paper",
      "elements": [
        {"type": "rect", "x": -3, "y": -3, "width": 3.8, "height": 61, "fill": "accent"},
        {"type": "text", "x": 5, "y": 9, "text": "FIELD NOTES", "font": "body", "size_pt": 10, "fill": "ink", "tracking_mm": 0.15},
        {"type": "text", "x": 85, "y": 9, "text": "COMMUNITY", "font": "label", "size_pt": 6.5, "fill": "muted", "align": "right"},
        {"type": "line", "x1": 5, "y1": 13, "x2": 85, "y2": 13, "stroke": "rule", "stroke_mm": 0.15},
        {"type": "text", "x": 5, "y": 25, "text": "MAKE SOMETHING.", "font": "body", "size_pt": 18, "fill": "ink", "tracking_mm": -0.12},
        {"type": "text", "x": 5, "y": 33, "text": "SHARE THE PROCESS.", "font": "body", "size_pt": 16, "fill": "accent", "tracking_mm": -0.12},
        {"type": "line", "x1": 5, "y1": 43, "x2": 85, "y2": 43, "stroke": "rule", "stroke_mm": 0.15},
        {"type": "text", "x": 5, "y": 49, "text": "THANK YOU FOR CREATING WITH US.", "font": "label", "size_pt": 6.5, "fill": "muted"}
      ]
    },
    {
      "id": "back",
      "name": "Back",
      "background": "paper",
      "elements": [
        {"type": "text", "x": 5, "y": 9, "text": "FIELD NOTES", "font": "body", "size_pt": 10, "fill": "ink", "tracking_mm": 0.15},
        {"type": "line", "x1": 5, "y1": 13, "x2": 85, "y2": 13, "stroke": "rule", "stroke_mm": 0.15},
        {"type": "text", "x": 5, "y": 23, "text": "JOIN THE\nCOMMUNITY.", "font": "body", "size_pt": 14, "fill": "accent", "line_height_mm": 6},
        {"type": "text", "x": 5, "y": 36, "text": "Ideas. Questions. Works in progress.", "font": "body", "size_pt": 6.5, "fill": "ink"},
        {"type": "qr", "x": 60, "y": 18, "size_mm": 25, "url": "https://example.org/", "dark": "qr_black", "light": "qr_white", "quiet_modules": 4},
        {"type": "line", "x1": 5, "y1": 45, "x2": 85, "y2": 45, "stroke": "rule", "stroke_mm": 0.15},
        {"type": "text", "x": 5, "y": 50, "text": "SCAN TO EXPLORE", "font": "label", "size_pt": 6.5, "fill": "accent"},
        {"type": "text", "x": 85, "y": 50, "text": "example.org", "font": "body", "size_pt": 6.5, "fill": "muted", "align": "right"}
      ]
    }
  ]
}
